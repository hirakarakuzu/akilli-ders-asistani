        "jsCode": "const text=($input.first().json.body||{}).text;\nif(!text||!String(text).trim()){return [{json:{success:false,error:'Ders notu bos olamaz.',skip:true}}];}\nreturn [{json:{ollamaBody:{model:'qwen2.5:7b',stream:false,messages:[\n{role:'system',content:'Sen bir universite egitim asistanisin. Verilen ders notunu Turkce ozetle. Sadece metindeki bilgileri kullan, disaridan bilgi ekleme. Once 2-3 cumlelik ozet yaz, sonra Anahtar Noktalar basligi altinda madde madde listele.'},\n{role:'user',content:String(text)}]}}}];"
      },
