        "path": "ozet",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "02599525-06e9-4350-8d44-74685a57a2e6",
      "name": "Uygulamadan İstek",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
