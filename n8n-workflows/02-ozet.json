    {
      "parameters": {
        "jsCode": "const j=$input.first().json;\nif(!j.message||!j.message.content){return [{json:{success:false,error:'Yapay zeka yanit veremedi.'}}];}\nreturn [{json:{success:true,summary:j.message.content}}];"
      },
