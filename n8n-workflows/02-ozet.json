        0,
        0
      ],
      "webhookId": "33cb65c3-ae49-40ef-8844-d38fe083d6b6"
    },
    {
      "parameters": {
        "jsCode": "const text=($input.first().json.body||{}).text;\nif(!text||!String(text).trim()){return [{json:{valid:false,error:'Ders notu bos olamaz.'}}];}\nconst sys='Sen bir universite egitim asistanisin. Verilen ders notunu Turkce ozetle. Sadece metindeki bilgileri kullan, disaridan bilgi ekleme. Once 2-3 cumlelik ozet yaz, sonra **Anahtar Noktalar** basligi altinda madde madde listele.';\nreturn [{json:{valid:true,ollamaBody:{model:'qwen2.5:7b',stream:false,options:{temperature:0.3,num_ctx:8192},messages:[{role:'system',content:sys},{role:'user',content:String(text)}]}}}];"
      },
      "id": "7cb9b7c3-5aa0-4dfd-a9a4-c1a8349adad4",
      "name": "İsteği Doğrula",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "7413f210-dbc8-448e-b1ff-0822a1beb31e",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1570e2f4-b0d4-43e8-b8c1-dd18b686e3b9",
      "name": "Geçerli mi?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
